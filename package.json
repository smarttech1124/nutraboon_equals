{
  "name": "nutraboom-equals",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "n-equals"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:admin": "npm run dev -w n-equals",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "next build",
    "build:admin": "npm run build -w n-equals",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "typecheck:admin": "npm run typecheck -w n-equals",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx scripts/seed-demo.ts",
    "vercel-build": "node scripts/vercel-build.mjs",
    "test:db": "node scripts/test-db.mjs",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.include=lib/** --coverage.include=components/** --coverage.include=app/** --coverage.exclude=lib/generated/**",
    "admin:secrets": "tsx scripts/admin-secrets.ts",
    "admin:create": "tsx scripts/admin-create.ts",
    "eval:conversations": "tsx scripts/eval/conversations.ts",
    "demo:record": "tsx scripts/demo/record-demo.ts",
    "demo:polish": "tsx scripts/demo/polish-demo.ts",
    "whatsapp:setup": "tsx scripts/whatsapp/setup-profile.ts",
    "whatsapp:videos": "tsx scripts/whatsapp/upload-demo-videos.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@google/genai": "^2.25.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.13.0",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
