# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/n-equals/.next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma client (generated by `prisma generate` on install)
/lib/generated

# test coverage reports
/coverage

# Demo video recordings (npm run demo:record)
/demo-output

# Internal development resources, kept locally but not shared in the repository.
# The app builds and deploys without them (see README.md, "Repository contents").
/.claude/
/.playwright-mcp/
/docs/
/tests/
/CLAUDE.md
/.vitest/
/_voice.ts

# Development, testing and demo scripts. Kept: vercel-build.mjs (deployment),
# admin-create.ts, admin-secrets.ts and prompt.ts (production administration),
# whatsapp/ (WhatsApp setup), food-data/ and price-data/ (seed data provenance).
/scripts/demo/
/scripts/eval/
/scripts/dev-all.mjs
/scripts/test-db.mjs
/scripts/seed-demo.ts
