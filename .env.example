# Which AI provider handles chat: "gemini", "claude" or "mock" (no key needed, canned replies).
# A configuration activated in n-equals (/ai) takes precedence.
AI_PROVIDER=gemini

# Google Gemini (server-side only, never exposed to the browser).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override. Defaults to gemini-3.8-flash.
GEMINI_MODEL=
# Optional backup model, used when the main one is overloaded, out of quota
# or unavailable after retries (e.g. gemini-3.5-flash-lite). Unset = no backup.
GEMINI_FALLBACK_MODEL=

# Anthropic Claude (AI_PROVIDER=claude). Key from https://console.anthropic.com
# (ANTHROPIC_API_KEY is also read). Optional model override; defaults to claude-opus-5-5.
CLAUDE_API_KEY=
CLAUDE_MODEL=

# PostgreSQL for foods data (Phase 2+). Without it, chat still works but
# cannot quote verified nutrition values.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/nutrichat
# Optional: a direct (non-pooled) connection for migrations and seeding, e.g.
# Neon's or Supabase's direct URL when DATABASE_URL goes through a pooler.
DIRECT_DATABASE_URL=

# Secret for hashing client IPs in the rate-limit table (any long random
# string). Set it in production so stored hashes cannot be reversed.
RATE_LIMIT_SECRET=

# Optional: a separate database for `npm test` DB integration tests.
# Its name must contain "test"; the tests replace all food rows in it.
DATABASE_URL_TEST=postgresql://USER:PASSWORD@localhost:5432/nutrichat_test

# Public address of the main site, used in email links and payment return
# URLs (no trailing slash). Defaults to http://localhost:3000.
APP_URL=

# Admin portal (n-equals, ADR-060/061). Administrators are accounts with an
# admin role, created with: npm run admin:create
# 32 random bytes, base64 (npm run admin:secrets). Encrypts AI and XEELAA keys
# saved in n-equals. Never change it once keys are saved: they could no longer
# be decrypted.
AI_CREDENTIALS_KEY=

# Payments (ADR-063). Use TEST-mode keys outside production. A provider is
# offered only when its keys are set and "Paid plans" is switched on in
# n-equals Settings. Webhook URLs: <APP_URL>/api/webhooks/paystack and
# <APP_URL>/api/webhooks/flutterwave
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# The "secret hash" set in the Flutterwave dashboard webhook settings.
FLUTTERWAVE_WEBHOOK_HASH=

# Email through Resend (ADR-065). EMAIL_FROM uses a domain verified in Resend,
# e.g. "Nutraboom Equals <hello@yourdomain.ng>". Without both, development
# logs emails and production sends none.
RESEND_API_KEY=
EMAIL_FROM=

# Cloudinary (ADR-064, ADR-090): nutritionist qualification documents (private),
# profile photos and the two WhatsApp sign-language demo videos. Without these,
# uploads and the WhatsApp video demo are switched off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Privacy notice at /privacy (ADR-053): who operates the service and where to
# send privacy questions. Set both before launch.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=

# Hospitals (ADR-068). Vercel Cron calls /api/cron/hospitals daily with
# "Authorization: Bearer $CRON_SECRET" for appointment reminders and to delete
# conversations 90 days after closing. Generate with `openssl rand -hex 32`.
CRON_SECRET=
# Optional: a different Nominatim server for place search. The public
# OpenStreetMap one (the default) allows at most one request a second.
NOMINATIM_URL=

# Google sign-in (ADR-071). Create an OAuth client (type "Web application")
# in Google Cloud Console > APIs & Services > Credentials, with the
# authorised redirect URI <APP_URL>/api/auth/google/callback. Without both
# values the "Continue with Google" button is hidden. APP_URL must be set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public site footer (ADR-070). Optional; anything unset is left out.
# CONTACT_EMAIL falls back to PRIVACY_CONTACT_EMAIL.
CONTACT_EMAIL=
# Comma-separated "Label|https://…" pairs, e.g. "Instagram|https://instagram.com/…"
SOCIAL_LINKS=

# Sign-language responses (ADR-077): demo (default, sample videos that do not
# translate replies), production (reserved for a real provider; not built yet) or off.
SIGN_LANGUAGE_PROVIDER=

# Demo accounts and the demo video (ADR-074, ADR-081; docs/DEMO_README.md).
# DEMO_PASSWORD lets the demo seed's accounts (demo-*@example.test) sign in;
# use a test value, never a real password. The rest are for npm run demo:record.
DEMO_PASSWORD=
DEMO_BASE_URL=
DEMO_EMAIL=
DEMO_ADMIN_URL=
DEMO_ADMIN_EMAIL=

# WhatsApp through Meta's Cloud API (ADR-087; setup in docs/whatsapp.md). Off until
# the first four are set. The webhook URL is <APP_URL>/api/whatsapp/webhook.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Optional: Graph API version (default v25.0) and the secret that hashes phone numbers
# (default RATE_LIMIT_SECRET; never change it once in use).
WHATSAPP_API_VERSION=
WHATSAPP_HASH_SECRET=

# WhatsApp voice notes and spoken replies (ADR-090). Speech-to-text providers are
# tried in order until one works ("claude" is listed but cannot read audio).
# Keys: GEMINI_API_KEY / OPENAI_API_KEY, or the active key saved in n-equals
# when it is for the same provider. Without any key, voice notes get a
# "please type" reply.
SPEECH_TO_TEXT_PROVIDERS=gemini,openai
# Spoken replies: "openai" or "off".
TEXT_TO_SPEECH_PROVIDER=openai
OPENAI_API_KEY=
# Optional model overrides (defaults: GEMINI_MODEL, gpt-4o-mini-transcribe,
# gpt-4o-mini-tts with the "alloy" voice).
GEMINI_TRANSCRIBE_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
# The sign-language demo videos (VIDEO ON) are served from the Cloudinary account
# above: run `npm run whatsapp:videos` once to upload them.
